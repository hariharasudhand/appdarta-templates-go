package gateway

import (
	"log"
	"net/http"
	"time"

	"github.com/google/uuid"

	"{{ .ModulePath }}/gateway/handlers/in"
)

// allowedLocalOrigins are the only browser origins granted local-dev CORS
// access: the Vite product-UI dev server. Deliberately not "*" — production
// traffic never carries a browser Origin header, so this is dev-only surface.
var allowedLocalOrigins = map[string]bool{
	"http://127.0.0.1:5173": true,
	"http://localhost:5173": true,
}

// Chain wraps a handler with the standard gateway middleware stack: local
// CORS (outermost — answers a browser preflight OPTIONS with 204 before
// AuthGate ever runs, since preflight requests never carry an Authorization
// header) → bearer AuthGate (rejects unauthenticated non-preflight requests
// with 401) → request-ID injection → structured access logging → next
// handler.
// GW-NO-NOOP-MW compliant: this is not a pass-through — it adds observable behaviour.
func Chain(next http.Handler) http.Handler {
	return withLocalCORS(in.AuthGate(loggingMiddleware(next)))
}

// withLocalCORS allows the local product-UI dev server (Vite on :5173) to
// call the gateway cross-origin during local runs. It sits outermost in
// Chain so a CORS preflight (OPTIONS) short-circuits with 204 before AuthGate
// runs — browsers never attach Authorization to preflight requests, so
// gating them on a bearer would break every cross-origin call. Only the two
// local Vite origins are allowed; this is not "*" and is not for any
// deployed environment.
func withLocalCORS(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		origin := r.Header.Get("Origin")
		if allowedLocalOrigins[origin] {
			w.Header().Set("Access-Control-Allow-Origin", origin)
			w.Header().Set("Access-Control-Allow-Headers", "Authorization, Content-Type")
			w.Header().Set("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
			w.Header().Set("Vary", "Origin")
		}
		if r.Method == http.MethodOptions {
			w.WriteHeader(http.StatusNoContent)
			return
		}
		next.ServeHTTP(w, r)
	})
}

// loggingMiddleware injects a correlation request ID and logs method/path/status/
// duration for every request that passes AuthGate.
func loggingMiddleware(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		start := time.Now()

		// Inject request ID so downstream services can correlate log lines.
		reqID := r.Header.Get("X-Request-ID")
		if reqID == "" {
			reqID = uuid.New().String()
		}
		w.Header().Set("X-Request-ID", reqID)
		r.Header.Set("X-Request-ID", reqID)

		// Delegate to next handler.
		wrapped := &responseWriter{ResponseWriter: w, status: http.StatusOK}
		next.ServeHTTP(wrapped, r)

		log.Printf("gateway: %s %s %d %s req=%s",
			r.Method, r.URL.Path, wrapped.status, time.Since(start), reqID)
	})
}

// responseWriter wraps http.ResponseWriter to capture the status code for logging.
type responseWriter struct {
	http.ResponseWriter
	status int
}

func (rw *responseWriter) WriteHeader(code int) {
	rw.status = code
	rw.ResponseWriter.WriteHeader(code)
}
