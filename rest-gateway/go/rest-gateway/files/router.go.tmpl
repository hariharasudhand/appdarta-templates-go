package gateway

import (
	"log"
	"net/http"
	"os"

	"gopkg.in/yaml.v3"
)

// handlerEntry mirrors one entry in config/gateway/in-handlers.yaml and out-handlers.yaml.
type handlerEntry struct {
	Name    string `yaml:"name"`
	Package string `yaml:"package"`
	File    string `yaml:"file"`
}

type handlerCatalog struct {
	Version  string         `yaml:"version"`
	Handlers []handlerEntry `yaml:"handlers"`
}

func loadHandlerCatalog(path string) handlerCatalog {
	data, err := os.ReadFile(path)
	if err != nil {
		log.Printf("gateway: handler catalog not found at %s: %v", path, err)
		return handlerCatalog{}
	}
	var catalog handlerCatalog
	if err := yaml.Unmarshal(data, &catalog); err != nil {
		log.Printf("gateway: failed to parse %s: %v", path, err)
		return handlerCatalog{}
	}
	return catalog
}

// Setup mounts inbound and outbound gateway routes onto mux.
// It loads config/gateway/in-handlers.yaml and config/gateway/out-handlers.yaml
// at startup to build the route table — no hard-coded handler list.
func Setup(mux *http.ServeMux, configDir string) {
	inCatalog := loadHandlerCatalog(configDir + "/in-handlers.yaml")
	outCatalog := loadHandlerCatalog(configDir + "/out-handlers.yaml")

	for _, h := range inCatalog.Handlers {
		handlerName := h.Name
		mux.HandleFunc("/in/"+handlerName, func(w http.ResponseWriter, r *http.Request) {
			w.Header().Set("X-Handler", handlerName)
			w.Header().Set("X-Direction", "inbound")
			w.WriteHeader(http.StatusOK)
		})
	}

	for _, h := range outCatalog.Handlers {
		handlerName := h.Name
		mux.HandleFunc("/out/"+handlerName, func(w http.ResponseWriter, r *http.Request) {
			w.Header().Set("X-Handler", handlerName)
			w.Header().Set("X-Direction", "outbound")
			w.WriteHeader(http.StatusOK)
		})
	}
}
