#!/usr/bin/env bash
# Local process launcher for agent "{{ .AgentName }}" — Docker-free app runtime (D1).
# DB/infra dependencies (if any) are still expected to be reachable separately;
# see the project root Makefile's `deps-up` target (Compose or native, depending
# on how those tanks were packaged — this script only starts the agent process).
set -euo pipefail
cd "$(dirname "$0")/../.."

PORT="${PORT:-8080}"
export PORT

echo "Starting agent {{ .AgentName }} on :$PORT (process runtime)"
echo "Health check: curl -sf http://localhost:$PORT/health"
exec go run ./cmd/{{ .AgentName }}
